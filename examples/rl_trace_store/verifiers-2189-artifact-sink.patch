diff --git a/verifiers/v1/utils/artifact_sink.py b/verifiers/v1/utils/artifact_sink.py
new file mode 100644
index 00000000..e98cea25
--- /dev/null
+++ b/verifiers/v1/utils/artifact_sink.py
@@ -0,0 +1,150 @@
+"""Durable storage for collected artifacts, addressing the transport-only gap.
+
+`collect()` keeps every tar archive on `trace.state.artifacts` — host memory that
+is excluded from serialization, so artifacts cost RAM for the life of the trace
+and cannot be inspected after the run. A sink moves each archive to durable
+storage as it is collected and leaves an `ArtifactRef` in its place; `restore()`
+fetches referenced archives back on demand. Refs are self-describing (they carry
+the spec that reopens their sink), so grading topologies need no sink plumbing.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import re
+from abc import ABC, abstractmethod
+from asyncio import to_thread
+from pathlib import Path
+
+from pydantic import BaseModel
+
+
+class ArtifactRef(BaseModel):
+    """Locator for one collected archive that lives in a sink, not in memory."""
+
+    sink: str
+    """Spec that reopens the sink (`load_sink(ref.sink)`), stamped by the sink."""
+    key: str
+    """Sink-internal storage key for the archive."""
+    source: str
+    """Original absolute source path — `restore`'s extraction root."""
+    size: int
+    """Archive size in bytes."""
+    sha256: str
+    """Digest of the archive; `get` verifies it before returning bytes."""
+
+
+class ArtifactSink(ABC):
+    """Where collected archives go instead of `trace.state`."""
+
+    spec: str
+    """The string `load_sink()` rebuilds this sink from. Set by the sink itself
+    (built-ins) or stamped by `load_sink` (plugged factories); recorded on every
+    ref this sink returns."""
+
+    @abstractmethod
+    async def put(
+        self, trace_id: str, source: str, data: bytes | None
+    ) -> ArtifactRef | None:
+        """Store one archive (or record an absent optional source when `data` is
+        `None`) under `trace_id` and return its ref (`None` for absences)."""
+
+    @abstractmethod
+    async def get(self, ref: ArtifactRef) -> bytes:
+        """Fetch an archive back, verifying size and digest. Fails loudly on any
+        mismatch: a tampered or truncated archive must not reach a grading box."""
+
+
+class DirectorySink(ArtifactSink):
+    """Archives and a per-trace `manifest.json` under a host directory.
+
+    Layout mirrors Harbor's durable trial outputs: `<root>/<trace_id>/` holds one
+    numbered tar per collected source plus a manifest recording per-source status
+    (`collected` with file/size/sha256, or `missing` for absent optional sources).
+    Writes are tmp+rename, so a reader never sees a torn archive or manifest.
+    """
+
+    def __init__(self, root: str | Path) -> None:
+        self.root = Path(root)
+        self.spec = str(root)
+
+    async def put(
+        self, trace_id: str, source: str, data: bytes | None
+    ) -> ArtifactRef | None:
+        return await to_thread(self._put_sync, trace_id, source, data)
+
+    async def get(self, ref: ArtifactRef) -> bytes:
+        return await to_thread(self._get_sync, ref)
+
+    def _put_sync(
+        self, trace_id: str, source: str, data: bytes | None
+    ) -> ArtifactRef | None:
+        trace_dir = self.root / trace_id
+        trace_dir.mkdir(parents=True, exist_ok=True)
+        manifest_path = trace_dir / "manifest.json"
+        manifest: dict[str, dict] = (
+            json.loads(manifest_path.read_text()) if manifest_path.exists() else {}
+        )
+        if data is None:
+            entry = {"file": None, "size": None, "sha256": None, "status": "missing"}
+            ref = None
+        else:
+            slug = re.sub(r"[^A-Za-z0-9._-]+", "-", source.strip("/"))[:80] or "root"
+            filename = f"{len(manifest):04d}-{slug}.tar"
+            digest = hashlib.sha256(data).hexdigest()
+            self._write_atomic(trace_dir / filename, data)
+            entry = {
+                "file": filename,
+                "size": len(data),
+                "sha256": digest,
+                "status": "collected",
+            }
+            ref = ArtifactRef(
+                sink=self.spec,
+                key=f"{trace_id}/{filename}",
+                source=source,
+                size=len(data),
+                sha256=digest,
+            )
+        manifest[source] = entry
+        self._write_atomic(manifest_path, json.dumps(manifest, indent=2).encode())
+        return ref
+
+    def _get_sync(self, ref: ArtifactRef) -> bytes:
+        data = (self.root / ref.key).read_bytes()
+        if len(data) != ref.size or hashlib.sha256(data).hexdigest() != ref.sha256:
+            raise RuntimeError(
+                f"artifact {ref.key!r} does not match its manifest digest — refusing "
+                "to restore a tampered or truncated archive"
+            )
+        return data
+
+    @staticmethod
+    def _write_atomic(path: Path, data: bytes) -> None:
+        tmp = path.with_name(path.name + ".tmp")
+        tmp.write_bytes(data)
+        os.replace(tmp, path)
+
+
+def load_sink(spec: str) -> ArtifactSink:
+    """Build a sink from its config string.
+
+    A plain directory path builds a `DirectorySink`. A plugged factory uses the
+    task-fn grammar (`pkg.module:factory` or `path/to/file.py:factory`), with an
+    optional `?args` tail passed to the factory as a single string; the factory
+    must return an `ArtifactSink`.
+    """
+    target, _, args = spec.partition("?")
+    if ":" not in target:
+        return DirectorySink(target)
+    # Deferred: loaders pulls in the env tree, which imports this module's users.
+    from verifiers.v1.utils.loaders import plugged_fn
+
+    factory = plugged_fn(target)
+    sink = factory(args) if args else factory()
+    if not isinstance(sink, ArtifactSink):
+        raise TypeError(f"artifact sink factory {target!r} returned {sink!r}")
+    sink.spec = spec
+    return sink
