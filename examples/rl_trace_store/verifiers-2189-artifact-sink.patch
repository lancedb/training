+"""Durable artifact sinks: collect() runs real tars on the host runtime and the
+DirectorySink round-trips them behind ArtifactRefs; restore() dereferences refs
+before extraction, unit-checked against a recording box (it refuses the host
+runtime by design). Default behavior — bytes on `trace.state` — stays byte-equal."""
+
+import hashlib
+import io
+import json
+import tarfile
+from types import SimpleNamespace
+
+import pytest
+
+import verifiers.v1 as vf
+from verifiers.v1.runtimes import make_runtime
+from verifiers.v1.runtimes.base import ProgramResult
+from verifiers.v1.runtimes.subprocess import SubprocessConfig
+from verifiers.v1.utils.artifact_sink import DirectorySink, load_sink
+from verifiers.v1.utils.artifacts import collect, restore
+
+
+@pytest.fixture
+async def host_runtime():
+    runtime = make_runtime(SubprocessConfig())
+    await runtime.start()
+    yield runtime
+    await runtime.teardown()
+
+
+@pytest.fixture
+def payload(tmp_path):
+    src = tmp_path / "out"
+    src.mkdir()
+    (src / "answer.txt").write_bytes(b"the-answer\n" * 512)
+    return src
+
+
+def tar_members(archive: bytes) -> list[str]:
+    with tarfile.open(fileobj=io.BytesIO(archive)) as tar:
+        return tar.getnames()
+
+
+async def test_collect_without_sink_keeps_bytes(host_runtime, payload):
+    collected = await collect(host_runtime, [vf.Artifact(source=str(payload))])
+    archive = collected[str(payload)]
+    assert isinstance(archive, bytes)
+    assert any(name.endswith("answer.txt") for name in tar_members(archive))
+
+
+async def test_collect_into_directory_sink(host_runtime, payload, tmp_path):
+    sink = DirectorySink(tmp_path / "store")
+    collected = await collect(
+        host_runtime, [vf.Artifact(source=str(payload))], sink=sink, trace_id="t1"
+    )
+
+    ref = collected[str(payload)]
+    assert isinstance(ref, vf.ArtifactRef)
+    assert ref.source == str(payload)
+
+    # the archive round-trips, digest-verified, and is a readable tar
+    archive = await sink.get(ref)
+    assert hashlib.sha256(archive).hexdigest() == ref.sha256
+    assert len(archive) == ref.size
+    assert any(name.endswith("answer.txt") for name in tar_members(archive))
+
+    # the manifest records per-source status, including the absent convention
+    # sweep (`/logs/artifacts` does not exist on the host runtime)
+    manifest = json.loads((tmp_path / "store" / "t1" / "manifest.json").read_text())
+    assert manifest[str(payload)]["status"] == "collected"
+    assert manifest[str(payload)]["sha256"] == ref.sha256
+    assert collected[vf.ARTIFACTS_DIR] is None
+    assert manifest[vf.ARTIFACTS_DIR]["status"] == "missing"
+
+
+async def test_restore_dereferences_refs(host_runtime, payload, tmp_path):
+    sink = DirectorySink(tmp_path / "store")
+    collected = await collect(
+        host_runtime, [vf.Artifact(source=str(payload))], sink=sink, trace_id="t1"
+    )
+    ref = collected[str(payload)]
+    original = await sink.get(ref)
+
+    class RecordingBox:
+        """The runtime surface restore() touches, recording uploads."""
+
+        config = SimpleNamespace(type="docker")
+
+        def __init__(self) -> None:
+            self.writes: dict[str, bytes] = {}
+
+        async def run(self, argv, env):
+            return ProgramResult(exit_code=0, stdout="", stderr="")
+
+        async def write(self, path, data):
+            self.writes[path] = data
+
+    box = RecordingBox()
+    await restore(box, {str(payload): ref})
+    assert list(box.writes.values()) == [original]
+
+
+async def test_restore_builds_each_sink_once(
+    host_runtime, payload, tmp_path, monkeypatch
+):
+    """A task's artifacts share one sink spec; restore must open it once, not
+    once per ref (an external sink opens storage in __init__)."""
+    sink = DirectorySink(tmp_path / "store")
+    collected = await collect(
+        host_runtime,
+        [
+            vf.Artifact(source=str(payload)),
+            vf.Artifact(source=str(payload / "answer.txt")),
+        ],
+        sink=sink,
+        trace_id="t1",
+    )
+    refs = {k: v for k, v in collected.items() if isinstance(v, vf.ArtifactRef)}
+    assert len(refs) >= 2 and len({r.sink for r in refs.values()}) == 1
+
+    import verifiers.v1.utils.artifacts as artifacts_mod
+
+    calls = []
+    real = artifacts_mod.load_sink
+    monkeypatch.setattr(
+        artifacts_mod, "load_sink", lambda spec: calls.append(spec) or real(spec)
+    )
+
+    class NoopBox:
+        config = SimpleNamespace(type="docker")
+
+        async def run(self, argv, env):
+            return ProgramResult(exit_code=0, stdout="", stderr="")
+
+        async def write(self, path, data):
+            pass
+
+    await restore(NoopBox(), refs)
+    assert len(calls) == 1  # one build for the shared spec, not one per ref
+
+
+async def test_get_refuses_tampered_archive(host_runtime, payload, tmp_path):
+    sink = DirectorySink(tmp_path / "store")
+    collected = await collect(
+        host_runtime, [vf.Artifact(source=str(payload))], sink=sink, trace_id="t1"
+    )
+    ref = collected[str(payload)]
+    stored = tmp_path / "store" / ref.key
+    stored.write_bytes(stored.read_bytes() + b"garbage")
+    with pytest.raises(RuntimeError, match="does not match its manifest digest"):
+        await sink.get(ref)
+
+
+def make_sink(args: str) -> DirectorySink:
+    """Factory for the plugged-spec test below."""
+    return DirectorySink(args)
+
+
+async def test_load_sink_specs(tmp_path):
+    assert isinstance(load_sink(str(tmp_path)), DirectorySink)
+
+    spec = f"{__file__}:make_sink?{tmp_path}"
+    sink = load_sink(spec)
+    assert isinstance(sink, DirectorySink)
+    assert sink.root == tmp_path
+    # the stamped spec makes refs self-describing across processes
+    assert sink.spec == spec
+    ref = await sink.put("t1", "/x", b"data")
+    assert ref.sink == spec
+    assert await load_sink(ref.sink).get(ref) == b"data"
